# ── apps/api ─────────────────────────────────────────────────────────────
# Copy to apps/api/.env and fill in. Never commit the real .env.

# Postgres connection string. Matches docker-compose.yml defaults for local dev.
DATABASE_URL=postgres://toolbridge:toolbridge@localhost:5432/toolbridge

# Better Auth signing secret. Also used as the HMAC key for OAuth state.
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public base URL of THIS api. OAuth callbacks are built from it, so it must be
# reachable by the browser during the OAuth redirect.
BETTER_AUTH_URL=http://localhost:3000

# Base URL of the web dashboard (CORS + auth trusted origin).
WEB_URL=http://localhost:5173

# AES-256-GCM key for encrypting stored provider credentials. Must decode to
# exactly 32 bytes. Generate: openssl rand -base64 32
ENCRYPTION_KEY=

# Port the api listens on. Optional (default 3000).
# PORT=3000
